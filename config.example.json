{
  "server": {
    "host": "127.0.0.1",
    "port": 24601,
    "max_body_bytes": 65536
  },
  "database": {
    "path": "./data/persona-sidecar.sqlite3"
  },
  "state": {
    "directory": "./data/personas"
  },
  "gateway": {
    "token_env": "SIDECAR_GATEWAY_TOKEN",
    "requests_per_minute": 60,
    "max_text_chars": 12000
  },
  "delivery": {
    "adapter": "webhook",
    "url": "http://127.0.0.1:24700/messages",
    "auth_token_env": "SIDECAR_DELIVERY_TOKEN",
    "timeout_seconds": 15,
    "max_attempts": 8,
    "poll_seconds": 0.25
  },
  "timing": {
    "reading_wpm": 220,
    "latency_median_seconds": 1.8,
    "latency_sigma": 0.45,
    "max_burst_chars": 500
  },
  "damage": {
    "enabled": true,
    "typo_probabilities": {
      "substitution": 0.002,
      "transposition": 0.001,
      "deletion": 0.001,
      "insertion": 0.001
    },
    "lowercase_start_probability": 0.02,
    "drop_terminal_punctuation_probability": 0.015,
    "self_correction_probability": 0.04
  },
  "egress": {
    "mode": "direct",
    "proxy_url": "",
    "proxy_url_env": "SIDECAR_PROXY_URL",
    "timeout_seconds": 12,
    "ip_observation_url": "https://api.ipify.org"
  },
  "affect": {
    "anchor": {
      "irritability": 0.15,
      "fatigue": 0.2,
      "elation": 0.2,
      "longing": 0.25,
      "dejection": 0.12,
      "play": 0.25
    },
    "base_tau_hours": {
      "irritability": 3,
      "fatigue": 8,
      "elation": 3,
      "longing": 8,
      "dejection": 8,
      "play": 3
    },
    "mood_follow_tau_hours": 12,
    "mood_return_tau_hours": 72,
    "mood_sleep_return_multiplier": 3,
    "sleep_gap_hours": 12,
    "mood_consolidation_gain": 4,
    "mood_consolidation_min": 0.25,
    "mood_consolidation_max": 2.5,
    "negativity_tau_multiplier": 1.6,
    "habituation_window_seconds": 900,
    "habituation_factor": 0.7
  },
  "classifier": {
    "backend": "rules",
    "endpoint": "http://127.0.0.1:11434/api/chat",
    "model": "qwen2.5:3b",
    "timeout_seconds": 8,
    "poll_seconds": 0.25
  },
  "personas": {
    "default": {
      "anchor": {
        "irritability": 0.15,
        "fatigue": 0.2,
        "elation": 0.2,
        "longing": 0.25,
        "dejection": 0.12,
        "play": 0.25
      }
    }
  }
}
